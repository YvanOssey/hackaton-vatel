{
  "name": "cantine-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-db.ts",
    "db:demo": "tsx --env-file-if-exists=.env scripts/demo-seed.ts",
    "db:neon:check": "tsx --env-file=.env.neon scripts/check-db.ts",
    "db:neon:migrate": "node --env-file=.env.neon node_modules/prisma/build/index.js migrate deploy",
    "db:neon:seed": "tsx --env-file=.env.neon prisma/seed.ts",
    "db:neon:copy": "tsx --env-file=.env.neon scripts/copy-to-neon.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jsqr": "1.4.0",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "three": "0.187.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

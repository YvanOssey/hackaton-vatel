# Base PostgreSQL
# En local, les deux adresses sont identiques.
# Avec Neon (voir docs/migration-neon.md, valeurs à mettre dans .env.neon ou dans Vercel) :
#   DATABASE_URL="postgresql://USER:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
#   DIRECT_URL="postgresql://USER:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DATABASE_URL="postgresql://cantine:cantine@localhost:5432/cantine?schema=public"
DIRECT_URL="postgresql://cantine:cantine@localhost:5432/cantine?schema=public"

# Secret de signature des QR Codes (32 caractères minimum, obligatoire en production)
# Générer avec : openssl rand -base64 48
AUTH_SECRET=""

# Fuseau horaire de l'établissement (heure limite, journée de service)
APP_TIMEZONE="Africa/Abidjan"

# Premier administrateur créé par `npm run db:seed` (mot de passe à changer à la 1re connexion)
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD=""

# Notifications push (Web Push, facultatif). Générer avec : npx web-push generate-vapid-keys
# Sans ces clés, les notifications restent dans la cloche de l'application.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.com"
